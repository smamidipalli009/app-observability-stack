global:
  resolve_timeout: 5m

route:
  receiver: 'default-notify'
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  routes:
    - match:
        severity: page
      receiver: 'default-notify'
      repeat_interval: 30m
    - match:
        severity: ticket
      receiver: 'default-notify'
      repeat_interval: 4h

receivers:
  - name: 'default-notify'
    slack_configs:
      - api_url: 'https://hooks.slack.com/services/XXXX/XXXX/XXXX'
        channel: '#alerts'
        send_resolved: true
        title: '{{ .CommonAnnotations.summary }}'
        text: '{{ .CommonAnnotations.description }}'
